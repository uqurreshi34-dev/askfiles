{
  "expo": {
    "name": "AskFiles",
    "slug": "askFiles",
    "version": "1.0.1",
    "orientation": "default",
    "scheme": "askfiles",
    "userInterfaceStyle": "automatic",
    "newArchEnabled": true,
    "icon": "./assets/icon.png",
    "splash": {
      "image": "./assets/splash-icon.png",
      "resizeMode": "contain",
      "backgroundColor": "#185FA5"
    },
    "android": {
      "package": "com.askfiles.mobile",
      "allowBackup": false,
      "permissions": [
        "android.permission.MANAGE_EXTERNAL_STORAGE",
        "android.permission.READ_MEDIA_IMAGES",
        "android.permission.READ_MEDIA_VIDEO",
        "android.permission.READ_MEDIA_AUDIO",
        "android.permission.READ_MEDIA_VISUAL_USER_SELECTED",
        "android.permission.RECORD_AUDIO",
        "android.permission.POST_NOTIFICATIONS"
      ],
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon.png",
        "backgroundColor": "#185FA5"
      }
    },
    "plugins": [
      "expo-router",
      "expo-media-library",
      "expo-font",
      [
        "expo-build-properties",
        {
          "android": {
            "enableEdgeToEdge": true,
            "compileSdkVersion": 35,
            "targetSdkVersion": 35
          }
        }
      ],
      "expo-web-browser",
      [
        "@react-native-google-signin/google-signin",
        {
          "googleServicesFile": "./google-services.json",
          "iosUrlScheme": "com.googleusercontent.apps.742437737318-cf3n02j03onq6ech51nkcup47q35jctm"
        }
      ],
      [
        "expo-speech-recognition",
        {
          "microphonePermission": "Allow AskFiles to use the microphone for voice search."
        }
      ],
      [
        "expo-notifications",
        {
          "icon": "./assets/icon.png",
          "color": "#185FA5",
          "sounds": []
        }
      ],
      "expo-secure-store",
      "./modules/storage-widget/app.plugin.js",
      "./modules/share-module/app.plugin.js",
      "./modules/smooth-rotation/app.plugin.js",
      "./modules/upload-service/app.plugin.js",
      "./modules/smb-client/app.plugin.js"
    ],
    "extra": {
      "router": {},
      "eas": {
        "projectId": "57398fc3-e1f3-493a-8522-0b6c5d0ab326"
      }
    }
  }
}
