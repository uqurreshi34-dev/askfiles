{
  "cli": {
    "version": ">= 18.7.0",
    "appVersionSource": "remote"
  },
  "build": {
    "development": {
      "developmentClient": true,
      "distribution": "internal"
    },
    "preview": {
      "distribution": "internal",
      "env": {
        "EXPO_PUBLIC_REVENUECAT_API_KEY": "secret:EXPO_PUBLIC_REVENUECAT_API_KEY",
        "EXPO_PUBLIC_GOOGLE_WEB_CLIENT_ID": "secret:EXPO_PUBLIC_GOOGLE_WEB_CLIENT_ID",
        "EXPO_PUBLIC_ONEDRIVE_CLIENT_ID": "secret:EXPO_PUBLIC_ONEDRIVE_CLIENT_ID",
        "EXPO_PUBLIC_DROPBOX_CLIENT_ID": "secret:EXPO_PUBLIC_DROPBOX_CLIENT_ID"
      }
    },
    "production": {
      "autoIncrement": true,
      "env": {
        "EXPO_PUBLIC_REVENUECAT_API_KEY": "secret:EXPO_PUBLIC_REVENUECAT_API_KEY",
        "EXPO_PUBLIC_GOOGLE_WEB_CLIENT_ID": "secret:EXPO_PUBLIC_GOOGLE_WEB_CLIENT_ID",
        "EXPO_PUBLIC_ONEDRIVE_CLIENT_ID": "secret:EXPO_PUBLIC_ONEDRIVE_CLIENT_ID",
        "EXPO_PUBLIC_DROPBOX_CLIENT_ID": "secret:EXPO_PUBLIC_DROPBOX_CLIENT_ID"
      }
    }
  },
  "submit": {
    "production": {}
  }
}
